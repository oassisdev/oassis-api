    "@x402/fetch": "^2.27.0",
    "@x402/hono": "^2.27.0",
    "hono": "^4.6.14",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.39.0"
  }
