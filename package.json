{
  "name": "oassis-api",
  "version": "1.0.1",
  "private": true,
  "description": "Web extraction and browser control for agents: one endpoint, many formats, pay per call.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
